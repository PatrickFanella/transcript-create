# Copy to the ignored path selected by HASANARA_DIARIZATION_ENV_FILE.
# This file is intentionally limited to the scoped Hugging Face credential and
# least-privilege diarization database URL. Set mode 0600 after copying. The
# existing role must have only: videos SELECT (id, state, wav_path,
# diarization_state, diarization_error, duration_seconds, updated_at, created_at), videos UPDATE
# (diarization_state, diarization_error, updated_at); segments SELECT (id,
# video_id, start_ms, end_ms, text, speaker_label, confidence, avg_logprob,
# temperature, token_count), and segments UPDATE (speaker_label).
HF_TOKEN=replace-with-rotated-hugging-face-token
DATABASE_URL=postgresql+psycopg://hasanara_diarization:replace-with-nondefault-password@db:5432/transcripts
